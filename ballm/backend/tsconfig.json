{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@ballm/platform": ["packages/platform/src/index.ts"],
      "@ballm/platform/*": ["packages/platform/src/*"]
    }
  },
  "include": ["packages", "services", "test", "scripts"]
}
