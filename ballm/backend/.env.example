# Ballm platform environment. Copy to .env for local development.
# Generate JWT keys and an encryption key with: bun run keys

BALLM_ENV=development
BALLM_REGION=local

# Control plane
PORT=8787
BALLM_CONTROL_PORT=8787
BALLM_PUBLIC_URL=http://localhost:8787

# Gateway
GATEWAY_PORT=8788
BALLM_GATEWAY_PORT=8788
BALLM_GATEWAY_PUBLIC_URL=http://localhost:8788

# Optional: serve /v1/* through the control plane for a single public hostname.
# BALLM_GATEWAY_INTERNAL_URL=http://gateway:8788

# Built console assets. Defaults to console/dist inside the backend.
BALLM_CONSOLE_DIR=

# Host ports used by docker compose only.
BALLM_POSTGRES_PORT=5432
BALLM_REDIS_PORT=6379

# Postgres. DATABASE_READ_URL may point at a regional read replica.
DATABASE_URL=postgres://ballm:ballm@localhost:5432/ballm
DATABASE_READ_URL=
BALLM_DB_POOL_MAX=20

# Optional but recommended for rate limits and instant revocation.
REDIS_URL=redis://localhost:6379

# JWT signing. Use files in production; inline PEM is also accepted.
BALLM_JWT_ISSUER=http://localhost:8787
BALLM_JWT_AUDIENCE=ballm-code
BALLM_JWT_KID=ballm-1
BALLM_JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
BALLM_JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
BALLM_ACCESS_TTL=300
BALLM_REFRESH_TTL=2592000
BALLM_BROWSER_TTL=28800

# Encrypts SSO client secrets and per-org upstream keys at rest.
BALLM_ENCRYPTION_KEY=

# Admin API bootstrap. Use a long random value.
BALLM_ADMIN_TOKEN=change-me-in-production

# Bootstrap the first org and its starter model catalog.
BALLM_BOOTSTRAP_ORG_ID=org_ballm
BALLM_BOOTSTRAP_ORG_SLUG=ballm
BALLM_BOOTSTRAP_ORG_NAME=Ballm
BALLM_BOOTSTRAP_ADMIN_EMAIL=admin@ballm.internal
BALLM_BOOTSTRAP_MODELS=ballm-fast:Ballm Fast,ballm-reasoning:Ballm Reasoning

# Optional bootstrap SSO connection for the bootstrap org.
BALLM_BOOTSTRAP_SSO_ISSUER=
BALLM_BOOTSTRAP_SSO_CLIENT_ID=
BALLM_BOOTSTRAP_SSO_CLIENT_SECRET=
BALLM_BOOTSTRAP_SSO_ALLOWED_DOMAINS=ballm.internal

# Gateway
BALLM_UPSTREAM_BASE_URL=
BALLM_UPSTREAM_API_KEY=
BALLM_GATEWAY_TIMEOUT_MS=600000
BALLM_GATEWAY_CONNECT_TIMEOUT_MS=15000
BALLM_GATEWAY_RATE_LIMIT_PER_MINUTE=240
BALLM_AUTH_RATE_LIMIT_PER_MINUTE=30

# Set to 1 only for local development. Never in production.
BALLM_DEV_AUTH=0
BALLM_MIGRATE_ON_START=1
BALLM_TRUST_PROXY=0
BALLM_LOG_LEVEL=info
