# Copy to .env and adjust for local development.
PORT=8787
BALLM_PUBLIC_URL=http://localhost:8787
BALLM_DB=./ballm.db

BALLM_ORG_ID=org_local
BALLM_ORG_NAME=Local

# Comma-separated id:Display Name pairs. The gateway forwards the id unchanged.
BALLM_MODELS=ballm-fast:Ballm Fast,ballm-reasoning:Ballm Reasoning

# OpenAI-compatible upstream, without the trailing /v1. Leave unset with BALLM_DEV_ECHO=1.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# Return a synthetic completion instead of proxying. Never enable in production.
BALLM_DEV_ECHO=1

# Allows POST /auth/device/approve for local development.
BALLM_ALLOW_DEV_APPROVE=1

BALLM_ACCESS_TTL=3600
BALLM_REFRESH_TTL=2592000
