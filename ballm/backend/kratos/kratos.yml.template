dsn: ${DSN}

serve:
  public:
    base_url: ${SERVE_PUBLIC_BASE_URL}
    cors:
      enabled: false
  admin:
    base_url: ${SERVE_ADMIN_BASE_URL}

selfservice:
  default_browser_return_url: ${SERVE_PUBLIC_BASE_URL}/console/
  allowed_return_urls:
    - ${SERVE_PUBLIC_BASE_URL}
    - ${SERVE_PUBLIC_BASE_URL}/console/
    - ${SERVE_PUBLIC_BASE_URL}/auth/password/complete
  flows:
    error:
      ui_url: ${SERVE_PUBLIC_BASE_URL}/console/login
    login:
      ui_url: ${SERVE_PUBLIC_BASE_URL}/console/login
      lifespan: 15m
    registration:
      ui_url: ${SERVE_PUBLIC_BASE_URL}/console/register
      lifespan: 15m
      after:
        password:
          hooks:
            - hook: session
    recovery:
      enabled: true
      ui_url: ${SERVE_PUBLIC_BASE_URL}/console/recover
      use: link
      after:
        default_browser_return_url: ${SERVE_PUBLIC_BASE_URL}/auth/password/complete
    verification:
      enabled: true
      ui_url: ${SERVE_PUBLIC_BASE_URL}/console/verify
      use: link
      after:
        default_browser_return_url: ${SERVE_PUBLIC_BASE_URL}/auth/password/complete
    settings:
      ui_url: ${SERVE_PUBLIC_BASE_URL}/console/settings
      privileged_session_max_age: 15m
      after:
        default_browser_return_url: ${SERVE_PUBLIC_BASE_URL}/console/
    logout:
      after:
        default_browser_return_url: ${SERVE_PUBLIC_BASE_URL}/console/
  methods:
    password:
      enabled: true
    link:
      enabled: true
    code:
      enabled: true

identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json

courier:
  smtp:
    connection_uri: ${COURIER_SMTP_CONNECTION_URI}
    from_address: noreply@baytai.io
    from_name: Ballm Code
  message_retries: 5

session:
  cookie:
    name: ory_kratos_session
    same_site: Lax
    secure: "${COOKIE_SECURE}"

log:
  level: ${LOG_LEVEL}
  format: json
