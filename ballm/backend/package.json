{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ballm/backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:control": "bun run --watch services/control-plane/src/index.ts",
    "dev:gateway": "bun run --watch services/gateway/src/index.ts",
    "start:control": "bun run services/control-plane/src/index.ts",
    "start:gateway": "bun run services/gateway/src/index.ts",
    "migrate": "bun run packages/platform/src/db/cli.ts",
    "keys": "bun run scripts/generate-keys.ts",
    "test": "./scripts/test.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/nodemailer": "^8.0.2",
    "jose": "^6.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "nodemailer": "^10.6.0"
  }
}
